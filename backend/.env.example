NODE_ENV=development
PORT=3000
API_VERSION=v1
APP_NAME="ERP Intelligent"
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000/api/v1
PUBLIC_LINK_SECRET=change_this_to_a_long_random_secret

DATABASE_URL="mysql://root:@localhost:3306/erp_intelligent"

JWT_ACCESS_SECRET=erp_access_secret_change_in_production_min32chars
JWT_REFRESH_SECRET=erp_refresh_secret_change_in_production_min32chars
JWT_ACCESS_EXPIRES=24h
JWT_REFRESH_EXPIRES=7d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.email@gmail.com
SMTP_PASS=mot_de_passe_application_gmail
SMTP_FROM="ERP Intelligent <votre.email@gmail.com>"

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# Optionnel: fonctionnalites IA
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20240620

# Stockage local uniquement pour le developpement; Render utilise un disque ephemere
UPLOAD_DIR=./uploads
LOG_FILE=./logs/erp.log
